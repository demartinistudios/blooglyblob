# Copy to config/app.env and explicitly select BLOOGLYBLOB_ENV_FILE.
# The installed application selects /etc/blooglyblob/app.env. Never commit secrets.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_RESPONSES_MODEL=gpt-5.6-terra
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
# OPENAI_VOICE=marin
# OPENAI_SPEECH_VOICE=marin
OPENAI_INACTIVITY_SECONDS=20
OPENAI_SESSION_MAX_SECONDS=600
MIC_GAIN=10
# Optional case-insensitive fragments; choose exactly one input/output each:
# AUDIO_INPUT_DEVICE=USB PnP Sound Device
# AUDIO_OUTPUT_DEVICE=USB Audio
# BLOOGLYBLOB_STATE_DIR=/var/lib/blooglyblob/brain
# BLOOGLYBLOB_MEDIA_DIR=/opt/blooglyblob/app
# Optional home integrations:
# TMDB_API_KEY=
# WATCHMODE_API_KEY=
# ROKU_IP=
# RING_TOKEN=
