# Host deployment settings; values are data, not shell expressions.
PI_HOST=blooglyblob.local
PI_USER=your-imager-username
# For an SSH Host alias with HostName and User configured, leave PI_USER empty.

# Copy config/app.env.example to a private file, edit it, and select it here.
# Only explicit provisioning uploads this input; existing remote settings win.
BLOOGLYBLOB_ENV_FILE=config/app.env
